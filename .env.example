# REINS Edu settings. The start scripts create .env from this file the first
# time, and the dashboard fills in the API key (Settings), so most lecturers
# never open it. Restart REINS Edu after editing it by hand.

# --- The AI tutor -------------------------------------------------------------
# anthropic (recommended: one key covers every feature) or gemini.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# The model that answers students (and, with Anthropic, drafts and grades).
CLAUDE_MODEL=claude-haiku-5-5
# "Not detailed enough? Ask again": the same question to a stronger model.
# Needs ANTHROPIC_API_KEY whatever LLM_PROVIDER is. Empty turns the button off.
CLAUDE_STRONG_MODEL=claude-sonnet-5-5
# The lecturer's "draft again with the best model" in the review queue. Empty: off.
CLAUDE_BEST_MODEL=claude-opus-5-5
# With LLM_PROVIDER=gemini: the chat model and the model that drafts and grades.
STUDENT_CHAT_MODEL=gemini-2.5-flash-lite
AGENT_MODEL=gemini-2.5-pro

# --- The student chat -----------------------------------------------------------
# The language of the chat's own messages: auto (Hebrew for a lab written in
# Hebrew, otherwise English), he or en. Also in the dashboard's Settings.
CHAT_LANGUAGE=auto
# Signs the students' sign-in sessions. The start scripts fill it in; keep it
# secret. (Make one by hand with: chainlit create-secret)
CHAINLIT_AUTH_SECRET=

# --- Sharing with students --------------------------------------------------------
# A fixed public address with ngrok instead of a new one every class: your free
# static domain from https://dashboard.ngrok.com (just the host, no https://).
# ngrok must be installed and signed in (ngrok config add-authtoken ...).
NGROK_DOMAIN=
# An address you set up yourself (a college server, your own Cloudflare tunnel):
# the dashboard shows it as the students' link, e.g. https://lab.example.edu/chat/
STUDENT_URL=

# --- Where things are kept --------------------------------------------------------
# The database (relative paths are inside the REINS Edu folder).
DB_PATH=reins.db
# Exercises, uploads and downloaded tools. Default: data/ inside the REINS Edu folder.
REINS_DATA_DIR=

# --- The server -------------------------------------------------------------------
# The port the start scripts use (the dashboard is http://localhost:<port>/).
REINS_PORT=8010
# The name students see on the IDE plugin's panels, when it isn't "REINS Edu" (a plugin
# built before the project was renamed keeps its older name). The tutor uses it.
# REINS_PLUGIN_NAME=
# The lecturer's dashboard works only on this computer, never through the public
# link. Set to false when REINS Edu runs on a server you reach from elsewhere.
TEACHER_LOCAL_ONLY=true
# --- Signing in without a password (also in the dashboard's Settings) -------------
# A 6-digit code by email: an outgoing mail server. Gmail: smtp.gmail.com, 587,
# the Gmail address, and an app password. SMTP_SECURITY: starttls, ssl or none
# (default: ssl on port 465, otherwise starttls). SMTP_FROM: empty = SMTP_USER.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Google: an OAuth client (Web application) from console.cloud.google.com, with
# http://localhost:8010/api/login/google/callback and
# https://<public address>/api/login/google/callback as redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# off turns a method off and keeps its settings.
SIGNIN_EMAIL=on
SIGNIN_GOOGLE=on
# The public address, when a proxy in front of REINS Edu doesn't pass it on
# (Google sends students back to it), e.g. https://lab.example.edu
REINS_PUBLIC_URL=

# Lock an IP out for 5 minutes after 4 failed sign-ins. Off by default: a whole
# class often shares one outgoing IP, so a few typos would block everyone.
LOGIN_RATE_LIMIT=false

# --- Answers and the question bank -------------------------------------------------
# Keep answers of the "ask again" model, so the same question in the same context
# costs nothing the second time. 0 days = keep until cleared.
ANSWER_CACHE=true
ANSWER_CACHE_DAYS=30
# A student's question this close (0..1) to a question-bank question shows the
# bank's answer in the review queue.
BANK_MATCH_THRESHOLD=0.45
# With review mode off, answer questions at least this close straight from the bank.
BANK_AUTO_ANSWER=false
BANK_AUTO_THRESHOLD=0.8
# How long drafting the review queue's answers may take, and its token budget.
TUTOR_TIMEOUT_SEC=120
TUTOR_MAX_TOKENS=8192

# --- The IDE plugin (pycharm-plugin branch) -----------------------------------------
# auto: show the plugin's screens in the dashboard once a plugin was used here.
PLUGIN_UI=auto
